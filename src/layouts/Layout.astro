---
import '../styles/global.css';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..900;1,100,400&family=Anton&family=Abril+Fatface&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..900;1,100,400&family=Anton&family=Abril+Fatface&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..900;1,100,400&family=Anton&family=Abril+Fatface&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <slot />
    <WhatsAppWidget />
    <script>
      import '../scripts/reveal-titles';
      import '../scripts/grow-sections';
      import '../scripts/reveal-steps';
      import '../scripts/reveal-impact';
      import '../scripts/reveal';
      import '../scripts/enhance-select';
    </script>
  </body>
</html>
