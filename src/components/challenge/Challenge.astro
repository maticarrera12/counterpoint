---
const items = [
  {
    num: '01',
    title: 'Diseño',
    text: 'Ver la marca antes de maquetarla.',
    accent: false,
    variant: 1,
  },
  {
    num: '02',
    title: 'Desarrollo',
    text: 'Prometer un diseño es fácil. Sostenerlo en producción, no tanto.',
    accent: true,
    variant: 2,
  },
  {
    num: '03',
    title: 'Producto',
    text: 'La próxima función rara vez es obvia.',
    accent: false,
    variant: 3,
  },
  {
    num: '04',
    title: 'Marca',
    text: 'Una identidad fuerte nunca se olvida.',
    accent: false,
    variant: 4,
  },
];
---

<section id="desafio" class="border-t-2 border-divider pt-[clamp(32px,5vw,60px)] px-[clamp(16px,4vw,56px)] pb-[clamp(48px,8vw,110px)]">
  <div class="flex justify-between items-baseline gap-4 text-[11px] tracking-[0.14em] uppercase font-semibold mb-[clamp(24px,5vw,60px)]">
    <span>03 / Lo que cuestionamos</span><span class="text-muted">Índice de disciplinas</span>
  </div>

  <div class="ch-grid">
    {items.map((item) => (
      <div class="ch-item" data-variant={item.variant}>
        <div class="ch-item__face ch-item__face--base">
          <div class:list={['ch-item__num', item.accent && 'text-accent']}>{item.num}</div>
          <h3 class="ch-item__title">{item.title}</h3>
          <p class="ch-item__text">{item.text}</p>
        </div>
        <div class="ch-item__reveal" aria-hidden="true">
          <div class="ch-item__face ch-item__face--inverted">
            <div class:list={['ch-item__num', item.accent && 'text-accent']}>{item.num}</div>
            <h3 class="ch-item__title">{item.title}</h3>
            <p class="ch-item__text">{item.text}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .ch-grid {
    --item-h: clamp(120px, 13vw, 180px);
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-divider);
  }

  .ch-item {
    position: relative;
    height: var(--item-h);
    overflow: hidden;
    border-bottom: 1px solid var(--color-divider);
  }

  .ch-item:last-child {
    border-bottom: 2px solid var(--color-divider);
  }

  .ch-item__face {
    box-sizing: border-box;
    height: var(--item-h);
    padding: clamp(14px, 2.4vw, 26px) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 clamp(8px, 1.6vw, 22px);
  }

  .ch-item__face--base {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .ch-item__face--inverted {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .ch-item__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(56px, 9vw, 130px);
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .ch-item__title {
    margin: 0;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .ch-item__text {
    margin: 0;
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.45;
  }

  /* Variant 01 — número, título, texto en orden; todo alineado arriba */
  .ch-item[data-variant="1"] .ch-item__face { align-items: start; }
  .ch-item[data-variant="1"] .ch-item__num { grid-column: 1 / 5; }
  .ch-item[data-variant="1"] .ch-item__title { grid-column: 5 / 9; }
  .ch-item[data-variant="1"] .ch-item__text { grid-column: 9 / 13; }

  /* Variant 02 — el texto arranca a la izquierda, número al medio (acento), título a la derecha */
  .ch-item[data-variant="2"] .ch-item__face { align-items: start; }
  .ch-item[data-variant="2"] .ch-item__text { grid-column: 1 / 3; grid-row: 1; }
  .ch-item[data-variant="2"] .ch-item__num { grid-column: 3 / 7; grid-row: 1; }
  .ch-item[data-variant="2"] .ch-item__title { grid-column: 7 / 11; grid-row: 1; }

  /* Variant 03 — título a la izquierda (abajo), número al medio, texto a la derecha */
  .ch-item[data-variant="3"] .ch-item__face { align-items: start; }
  .ch-item[data-variant="3"] .ch-item__title { grid-column: 1 / 6; align-self: end; }
  .ch-item[data-variant="3"] .ch-item__num { grid-column: 6 / 10; }
  .ch-item[data-variant="3"] .ch-item__text { grid-column: 10 / 13; }

  /* Variant 04 — texto a la izquierda, título al medio, número a la derecha; todo alineado abajo */
  .ch-item[data-variant="4"] .ch-item__face { align-items: end; }
  .ch-item[data-variant="4"] .ch-item__text { grid-column: 1 / 4; grid-row: 1; }
  .ch-item[data-variant="4"] .ch-item__title { grid-column: 4 / 9; grid-row: 1; }
  .ch-item[data-variant="4"] .ch-item__num { grid-column: 9 / 13; grid-row: 1; text-align: right; }

  .ch-item__reveal {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    overflow: hidden;
    transition: height 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ch-item:hover .ch-item__reveal,
  .ch-item:focus-within .ch-item__reveal {
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-item__reveal { transition: none; }
  }

  @media (max-width: 700px) {
    .ch-grid { --item-h: clamp(200px, 62vw, 260px); }
    .ch-item__face,
    .ch-item[data-variant] .ch-item__face { grid-template-columns: 1fr; align-items: start; row-gap: 8px; }
    .ch-item[data-variant] .ch-item__num,
    .ch-item[data-variant] .ch-item__title,
    .ch-item[data-variant] .ch-item__text {
      grid-column: 1 / -1;
      grid-row: auto;
      align-self: start;
      text-align: left;
    }
  }
</style>
