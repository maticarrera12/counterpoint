---
const steps = [
  { num: '01', verb: 'Observar', text: 'Nos involucramos en tu negocio para comprender tu propuesta, conocer a tu público e identificar qué necesita encontrar.' },
  { num: '02', verb: 'Preguntar', text: '¿Qué distingue a tu marca? ¿Qué facilita una consulta o una compra? Las preguntas correctas orientan cada decisión de diseño.' },
  { num: '03', verb: 'Replantear', text: 'Transformamos ideas en una propuesta clara: qué comunicar, cómo presentarlo y cómo guiar al usuario hacia el siguiente paso.' },
  { num: '04', verb: 'Decidir', text: 'Cada palabra, cada imagen y cada botón responden a un objetivo: comunicar tu valor y contribuir al crecimiento de tu negocio.' },
  { num: '05', verb: 'Actuar.', text: 'Del concepto al sitio publicado. Diseñamos, desarrollamos y acompañamos la puesta en marcha de tu web.' },
];
import Sunburst from '../Sunburst.astro';
---

<section id="proceso" data-reveal-title class="py-[clamp(72px,9vw,140px)]">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-[clamp(32px,4vw,64px)] px-[clamp(16px,4vw,56px)] lg:grid-cols-3">
    <div class="flex flex-col gap-7">
      <div data-reveal="fade" class="flex gap-10 text-[13px] tracking-[0.16em] uppercase font-bold"><span>05</span><span class="text-muted">Cómo avanza el trabajo</span></div>
      <h2 class="m-0 font-stretch-expanded text-[clamp(26px,2.6vw,40px)] leading-[1.02] tracking-[-0.035em] uppercase"><span class="font-light">Tu sitio web comienza </span><span class="font-black">mucho antes del primer clic.</span></h2>
      <div data-reveal="clip" class="sb-scope hidden aspect-square overflow-hidden border-[1.5px] border-text bg-bg text-text lg:block" aria-hidden="true">
        <Sunburst width={400} height={400} rays={24} twist={0.2} />
      </div>
      <div class="text-[13px] tracking-[0.2em] uppercase font-bold text-muted">No lineal, por diseño.</div>
    </div>
    <ol class="m-0 list-none self-end border-b-[1.5px] border-text p-0 lg:col-span-2">
      {steps.map((s, i) => (
        <li data-reveal="up" style={`--rd:${i * 60}ms`} class="grid grid-cols-[48px_minmax(0,1fr)] items-baseline gap-x-[clamp(16px,2vw,32px)] gap-y-2 border-t-[1.5px] border-text py-[clamp(20px,2.4vw,32px)] [&>*]:transition-transform [&>*]:duration-300 [&>*]:ease-snap hover:[&>*]:translate-x-3">
          <span class="text-[13px] font-bold tracking-[0.1em] text-accent">{s.num}</span>
          <div class="grid grid-cols-1 items-baseline gap-x-[clamp(16px,2vw,32px)] gap-y-3 xl:grid-cols-[1.6fr_1fr]">
            <h3 class="m-0 font-stretch-expanded font-black text-[clamp(32px,3.6vw,56px)] leading-[0.9] tracking-[-0.05em] uppercase">{s.verb}</h3>
            <p class="m-0 max-w-[40ch] text-[15px] leading-[1.5] text-muted text-pretty">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
