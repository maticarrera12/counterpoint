---
import ImgSlot from '../ImgSlot.astro';

const projects = [
  { num: '01', name: 'Consultora Nexo', category: 'Identidad y sitio web', src: '/img/nexo.webp', alt: 'nexo consulting', width: 3024, height: 1964 },
  { num: '02', name: 'Estudio jurídico Lasalle', category: 'Primer sitio institucional', src: '/img/lasalle.webp', alt: 'Lasalle', width: 1600, height: 1004 },
  // Hidden placeholder (third slot). The grid stays at 3 columns so the cards keep their size.
  // { num: '03', name: 'Proyecto de muestra', category: 'Sitio web', src: '/img/geisel.webp', alt: 'Proyecto de muestra', width: 700, height: 394 },
];
---

<section id="trabajo" class="bg-text text-bg font-body px-[clamp(16px,4vw,56px)] pb-[clamp(40px,7vw,100px)]">
  <div class="flex flex-col md:flex-row border-t border-bg/15">
    <h2 data-reveal="fade" class="m-0 bg-accent text-bg px-4 py-3 md:px-0 md:py-6 md:w-[clamp(56px,6vw,84px)] shrink-0 font-stretch-extra-condensed text-[clamp(18px,1.9vw,28px)] tracking-[0.1em] uppercase md:[writing-mode:vertical-rl] md:rotate-180 md:text-center">Trabajo seleccionado</h2>
    <div class="flex-1 grid grid-cols-1 md:grid-cols-3 gap-[clamp(20px,3vw,44px)] pt-6 md:p-[clamp(20px,3vw,44px)]">
      {projects.map((p, i) => (
        <article class="group flex flex-col gap-3">
          <div data-reveal="left" style={`--rd:${i * 140}ms`} class="text-accent text-[clamp(14px,1.3vw,18px)] font-semibold tracking-[0.06em]">{p.num}/</div>
          <div data-reveal="clip" style={`--rd:${i * 140 + 60}ms`} class="relative aspect-[16/10] bg-bg/5 overflow-hidden [&_img]:transition-[scale] [&_img]:duration-700 [&_img]:ease-snap group-hover:[&_img]:scale-[1.05]">
            <ImgSlot src={p.src} alt={p.alt} width={p.width} height={p.height} fit="cover" />
          </div>
          <h3 data-reveal="up" style={`--rd:${i * 140 + 260}ms`} class="m-0 font-stretch-extra-condensed text-[clamp(16px,1.5vw,22px)] tracking-[0.04em] uppercase transition-colors duration-200 group-hover:text-accent">{p.name}</h3>
          <p data-reveal="up" style={`--rd:${i * 140 + 340}ms`} class="m-0 -mt-2 text-[13px] tracking-[0.08em] uppercase text-bg/60">{p.category}</p>
        </article>
      ))}
    </div>
  </div>
</section>
