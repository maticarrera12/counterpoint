<section style="padding: clamp(48px, 8vw, 120px) clamp(16px, 4vw, 56px) clamp(40px, 7vw, 100px); position: relative; overflow: hidden;">
  <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; margin-bottom: clamp(16px, 3vw, 36px);">05 / Impacto — medido, no insinuado</div>
  <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px);">
    <div style="grid-column: 1 / 10; grid-row: 1; font-family: var(--font-heading); font-weight: 800; font-size: clamp(72px, 20vw, 300px); line-height: 0.76; letter-spacing: -0.06em;">10<span style="color: var(--ac);">+</span></div>
    <div style="grid-column: 9 / 13; grid-row: 1; align-self: end; border-top: 2px solid var(--color-divider); padding-top: 8px; font-size: clamp(13px, 1.2vw, 16px); line-height: 1.4;">Sitios y productos digitales. Cada uno, sostenido después del deploy..</div>
  </div>
  <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); margin-top: clamp(-10px, -1vw, 0px);">
    <div style="grid-column: 1 / 5; align-self: center; border-top: 2px solid var(--color-divider); padding-top: 8px; font-size: clamp(13px, 1.2vw, 16px); line-height: 1.4;">Años de formacion tecnica y experiencia en el mercado digital.</div>
    <div style="grid-column: 5 / 10; font-family: var(--font-heading); font-weight: 800; font-size: clamp(72px, 20vw, 300px); line-height: 0.78; letter-spacing: -0.06em; text-align: center;">3</div>
    <div style="grid-column: 10 / 13; align-self: end; writing-mode: vertical-rl; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 600; color: var(--ac); justify-self: end;">Evidencia, no anécdota</div>
  </div>
  <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); border-bottom: 2px solid var(--color-divider);">
    <div style="grid-column: 4 / 13; font-family: var(--font-heading); font-weight: 800; font-size: clamp(72px, 20vw, 300px); line-height: 0.8; letter-spacing: -0.06em; text-align: right;">100%</div>
    <div style="grid-column: 1 / 4; align-self: end; padding-bottom: clamp(10px, 2vw, 26px); font-size: clamp(13px, 1.2vw, 16px); line-height: 1.4;">de los clientes satisfechos.</div>
  </div>
</section>
