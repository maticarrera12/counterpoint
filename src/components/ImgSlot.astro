---
interface Props {
  dark?: boolean;
  src?: string;
  alt?: string;
}

const { dark = false, src, alt = '' } = Astro.props;
---

<div
  class:list={[
    'img-slot',
    src && 'border-none bg-transparent p-0',
    !src && dark && 'bg-bg/8 border-bg/28',
  ]}
>
  {src ? (
    <img src={src} alt={alt} class="w-full h-full object-contain block" />
  ) : (
    <span class:list={[dark && 'text-bg/60']}><slot /></span>
  )}
</div>
