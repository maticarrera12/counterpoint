---
interface Props {
  dark?: boolean;
  src?: string;
  alt?: string;
}

const { dark = false, src, alt = '' } = Astro.props;
---

<div
  class="img-slot"
  style={src
    ? 'border: none; background: transparent; padding: 0;'
    : dark
      ? 'background: rgba(243,242,242,0.08); border-color: rgba(243,242,242,0.28);'
      : undefined}
>
  {src ? (
    <img src={src} alt={alt} style="width: 100%; height: 100%; object-fit: contain; display: block;" />
  ) : (
    <span style={dark ? 'color: rgba(243,242,242,0.6);' : undefined}><slot /></span>
  )}
</div>
