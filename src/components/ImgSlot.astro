---
interface Props {
  dark?: boolean;
  src?: string;
  alt?: string;
  fit?: 'contain' | 'cover';
}

const { dark = false, src, alt = '', fit = 'contain' } = Astro.props;
---

<div
  class:list={[
    'img-slot',
    src && 'border-none bg-transparent p-0',
    !src && dark && 'bg-bg/8 border-bg/28',
  ]}
>
  {src ? (
    <img src={src} alt={alt} class:list={['w-full h-full block', fit === 'cover' ? 'object-cover' : 'object-contain']} />
  ) : (
    <span class:list={[dark && 'text-bg/60']}><slot /></span>
  )}
</div>
