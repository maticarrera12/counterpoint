---
import { BUDGETS, PROJECT_TYPES } from '../../lib/contact-options';

const contactEmail = 'mcarreradev@gmail.com';
const whatsappHref = 'https://wa.me/5491154793056';

const labelClass = 'block text-[11px] tracking-[0.14em] uppercase font-semibold mb-2';
const fieldClass =
  'block w-full bg-transparent border-0 border-b-2 border-divider rounded-none px-0 py-3 text-[clamp(16px,1.4vw,20px)] leading-[1.4] text-text placeholder:text-muted transition-colors duration-300 focus:border-accent aria-[invalid=true]:border-accent';
const errorClass = 'text-accent text-[12px] leading-[1.4] min-h-[1.4em] mt-1.5';
---

<section id="contacto" class="border-t-2 border-divider pt-[clamp(48px,8vw,120px)] px-[clamp(16px,4vw,56px)] pb-[clamp(56px,9vw,130px)]">
  <div class="text-[11px] tracking-[0.14em] uppercase font-semibold mb-[10px]">09 / Contacto</div>
  <h2 class="m-0 text-[clamp(34px,6.6vw,108px)] leading-[0.94] tracking-[-0.04em] max-w-[14ch]">
    Contanos qué querés <span class="text-accent italic font-normal">construir.</span>
  </h2>
  <p class="text-muted mt-3 mb-[clamp(28px,5vw,70px)] text-[clamp(15px,1.4vw,19px)] leading-[1.5] max-w-[52ch]">
    Una conversación no compromete a nada. Respondemos dentro de las 48 hs hábiles.
  </p>

  <div class="grid grid-cols-12 gap-y-[clamp(32px,5vw,56px)] gap-x-[clamp(8px,1.6vw,22px)]">
    <div class="col-[1/13] md:col-[1/9]">
      <form id="contact-form" class="relative grid gap-y-[clamp(20px,2.6vw,32px)]" method="post" action="/api/contact">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-[clamp(20px,2.6vw,32px)] gap-x-[clamp(16px,3vw,40px)]">
          <div>
            <label for="contact-nombre" class={labelClass}>Nombre</label>
            <input
              id="contact-nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              aria-describedby="contact-nombre-error"
              class={fieldClass}
            />
            <p id="contact-nombre-error" data-error-for="nombre" class={errorClass}></p>
          </div>
          <div>
            <label for="contact-email" class={labelClass}>Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              aria-describedby="contact-email-error"
              class={fieldClass}
            />
            <p id="contact-email-error" data-error-for="email" class={errorClass}></p>
          </div>
        </div>

        <div>
          <label for="contact-whatsapp" class={labelClass}>
            WhatsApp <span class="text-muted normal-case tracking-normal font-normal">(opcional)</span>
          </label>
          <input
            id="contact-whatsapp"
            name="whatsapp"
            type="tel"
            autocomplete="tel"
            aria-describedby="contact-whatsapp-error"
            class={fieldClass}
          />
          <p id="contact-whatsapp-error" data-error-for="whatsapp" class={errorClass}></p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-[clamp(20px,2.6vw,32px)] gap-x-[clamp(16px,3vw,40px)]">
          <div>
            <label for="contact-tipo" class={labelClass}>Tipo de proyecto</label>
            <select
              id="contact-tipo"
              name="tipoProyecto"
              required
              aria-describedby="contact-tipo-error"
              class={fieldClass}
            >
              <option value="" disabled selected>Elegí una opción</option>
              {PROJECT_TYPES.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
            <p id="contact-tipo-error" data-error-for="tipoProyecto" class={errorClass}></p>
          </div>
          <div>
            <label for="contact-presupuesto" class={labelClass}>
              Presupuesto <span class="text-muted normal-case tracking-normal font-normal">(opcional)</span>
            </label>
            <select
              id="contact-presupuesto"
              name="presupuesto"
              aria-describedby="contact-presupuesto-error"
              class={fieldClass}
            >
              <option value="">Sin definir</option>
              {BUDGETS.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
            <p id="contact-presupuesto-error" data-error-for="presupuesto" class={errorClass}></p>
          </div>
        </div>

        <div>
          <label for="contact-mensaje" class={labelClass}>Mensaje</label>
          <textarea
            id="contact-mensaje"
            name="mensaje"
            rows="5"
            required
            minlength="20"
            aria-describedby="contact-mensaje-error"
            placeholder="Qué necesitás, para cuándo y qué problema querés resolver."
            class:list={[fieldClass, 'resize-y min-h-[8rem]']}
          ></textarea>
          <p id="contact-mensaje-error" data-error-for="mensaje" class={errorClass}></p>
        </div>

        <!-- Honeypot: off-screen, out of tab order, hidden from assistive tech. -->
        <div aria-hidden="true" class="absolute -left-[9999px] top-auto w-px h-px overflow-hidden">
          <label for="contact-empresa-web">Empresa web (no completar)</label>
          <input id="contact-empresa-web" name="empresa_web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <button
            type="submit"
            id="contact-submit"
            data-label="Enviar consulta →"
            class="btn btn-primary text-[13px] tracking-[0.1em] uppercase px-[22px] py-[14px] disabled:opacity-60 disabled:cursor-not-allowed"
          >Enviar consulta →</button>
        </div>

        <div
          id="contact-error"
          role="alert"
          hidden
          class="border-l-2 border-accent pl-[clamp(12px,2vw,20px)] text-[clamp(14px,1.2vw,17px)] leading-[1.5]"
        >
          No pudimos enviar tu consulta. Escribinos directamente a{' '}
          <a href={`mailto:${contactEmail}`} class="text-accent underline underline-offset-4">{contactEmail}</a>.
        </div>
      </form>

      <div
        id="contact-success"
        role="status"
        tabindex="-1"
        hidden
        class="border-t-2 border-accent pt-[clamp(16px,2.4vw,28px)] focus-visible:outline-none"
      >
        <div class="text-accent text-[11px] tracking-[0.14em] uppercase font-semibold mb-3">Consulta enviada</div>
        <p class="m-0 text-[clamp(22px,3vw,44px)] leading-[1.1] tracking-[-0.03em] max-w-[22ch] font-heading font-extrabold">
          Recibimos tu consulta.
        </p>
        <p class="text-muted mt-3 mb-0 text-[clamp(15px,1.4vw,19px)] leading-[1.5] max-w-[46ch]">
          Te respondemos dentro de las 48 hs hábiles. Te enviamos una confirmación por mail.
        </p>
      </div>
    </div>

    <aside class="col-[1/13] md:col-[10/13] grid content-start gap-y-[clamp(20px,3vw,36px)]">
      <div class="border-t-2 border-accent pt-2.5">
        <div class="text-[11px] tracking-[0.14em] uppercase font-semibold mb-2">Mail directo</div>
        <a href={`mailto:${contactEmail}`} class="text-[clamp(16px,1.5vw,22px)] leading-[1.3] break-words">{contactEmail}</a>
      </div>
      <div class="border-t-2 border-divider pt-2.5">
        <div class="text-[11px] tracking-[0.14em] uppercase font-semibold mb-2">WhatsApp</div>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="text-[clamp(16px,1.5vw,22px)] leading-[1.3]">+54 11 5479 3056</a>
      </div>
      <div class="border-t-2 border-divider pt-2.5">
        <div class="text-[11px] tracking-[0.14em] uppercase font-semibold mb-2">Oficina</div>
        <p class="text-muted m-0 text-[clamp(14px,1.2vw,17px)] leading-[1.5]">Buenos Aires — San Isidro</p>
      </div>
    </aside>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const errorBox = document.getElementById('contact-error') as HTMLElement;
    const successBox = document.getElementById('contact-success') as HTMLElement;
    const idleLabel = submitBtn.dataset.label ?? submitBtn.textContent ?? '';

    // Native validation stays as the no-JS fallback; with JS we render inline messages instead.
    form.noValidate = true;

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    const getField = (name: string) => form.elements.namedItem(name) as Field | null;
    const getErrorEl = (name: string) => form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    const setError = (name: string, message: string) => {
      const field = getField(name);
      const el = getErrorEl(name);
      if (el) el.textContent = message;
      if (field) {
        if (message) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      }
    };

    const validators: Record<string, (value: string, field: Field) => string> = {
      nombre: (v) => (v.trim() ? '' : 'Contanos tu nombre.'),
      email: (v, f) =>
        v.trim() && (f as HTMLInputElement).validity.valid ? '' : 'Ingresá un email válido.',
      tipoProyecto: (v) => (v ? '' : 'Elegí un tipo de proyecto.'),
      mensaje: (v) => (v.trim().length >= 20 ? '' : 'Contanos un poco más (mínimo 20 caracteres).'),
    };

    const validateAll = () => {
      let firstInvalid: Field | null = null;
      for (const [name, validate] of Object.entries(validators)) {
        const field = getField(name);
        if (!field) continue;
        const message = validate(field.value, field);
        setError(name, message);
        if (message && !firstInvalid) firstInvalid = field;
      }
      return firstInvalid;
    };

    // Clear a field's error as soon as the user edits it.
    form.addEventListener('input', (e) => {
      const target = e.target as Field;
      if (target?.name && target.getAttribute('aria-invalid') === 'true') {
        const validate = validators[target.name];
        if (validate && !validate(target.value, target)) setError(target.name, '');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      const firstInvalid = validateAll();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          // Hold the column at the form's height while we scroll up to the section title,
          // then release it so the page doesn't collapse under the reader's viewport.
          const column = form.parentElement as HTMLElement;
          column.style.minHeight = `${column.offsetHeight}px`;
          const release = () => {
            column.style.minHeight = '';
          };

          form.hidden = true;
          successBox.hidden = false;
          successBox.focus({ preventScroll: true });

          const startY = window.scrollY;
          document.getElementById('contacto')?.scrollIntoView({ block: 'start' });

          // Release only once the scroll has actually settled; shrinking earlier
          // near the page bottom makes the browser clamp and cut the animation short.
          let last = startY;
          let moved = false;
          let stableTicks = 0;
          let ticks = 0;
          const timer = window.setInterval(() => {
            const y = window.scrollY;
            if (Math.abs(y - startY) >= 1) moved = true;
            stableTicks = Math.abs(y - last) < 1 ? stableTicks + 1 : 0;
            last = y;
            ticks += 1;
            if ((moved && stableTicks >= 6) || ticks > 60) {
              window.clearInterval(timer);
              release();
            }
          }, 50);
          return;
        }

        if (res.status === 400) {
          const body = await res.json().catch(() => null);
          const fieldErrors: Record<string, string[]> | undefined = body?.errors;
          if (fieldErrors) {
            let first: Field | null = null;
            for (const [name, messages] of Object.entries(fieldErrors)) {
              if (!messages?.length) continue;
              setError(name, messages[0]);
              first ??= getField(name);
            }
            if (first) {
              first.focus();
              return;
            }
          }
        }

        errorBox.hidden = false;
      } catch {
        errorBox.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = idleLabel;
      }
    });
  }
</script>
