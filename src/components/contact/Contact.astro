---
import { PROJECT_TYPES } from '../../lib/contact-options';
import { whatsappUrl } from '../../lib/whatsapp';
import BrandMark from '../BrandMark.astro';
import Sunburst from '../Sunburst.astro';

const contactEmail = 'proyectos@estudiocounterpoint.com';
const whatsappHref = whatsappUrl('Hola, quiero hacer una consulta.');

const labelClass = 'block text-[13px] tracking-[0.08em] uppercase font-semibold mb-2';
const fieldClass =
  'block w-full bg-transparent border-0 border-b-2 border-divider rounded-none px-0 py-3 text-[clamp(16px,1.4vw,20px)] leading-[1.4] text-text placeholder:text-muted transition-colors duration-200 ease-snap focus:border-accent aria-[invalid=true]:border-accent';
const selectClass =
  'appearance-none pr-7 cursor-pointer [&>option]:text-text [&>option]:bg-bg';
const errorClass = 'text-accent text-[16px] leading-[1.4] min-h-[1.4em] mt-1.5';
---

<section id="contacto" class="pb-[clamp(72px,9vw,140px)]">
  <div class="mx-auto max-w-[1440px] px-[clamp(16px,4vw,56px)]">
  <div data-reveal="fade" class="flex flex-wrap items-center justify-between gap-6 border-t-[1.5px] border-text py-[clamp(28px,3vw,40px)]">
    <p class="m-0 max-w-[42ch] text-[clamp(18px,1.6vw,24px)] leading-[1.35]">Tu próximo cliente necesita comprender por qué elegirte. Diseñemos un sitio que comunique esa diferencia.</p>
    <div class="flex gap-10 text-[13px] tracking-[0.16em] uppercase font-bold"><span>06</span><span class="text-muted">Contacto</span></div>
  </div>

  <div class="grid grid-cols-12 gap-y-[clamp(32px,5vw,56px)] gap-x-[clamp(8px,1.6vw,22px)]">
    <div hidden class="col-[1/13] md:col-[1/9]">
      <form id="contact-form" class="relative grid gap-y-[clamp(20px,2.6vw,32px)]" method="post" action="/api/contact">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-[clamp(20px,2.6vw,32px)] gap-x-[clamp(16px,3vw,40px)]">
          <div>
            <label for="contact-nombre" class={labelClass}>Nombre</label>
            <input
              id="contact-nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              aria-describedby="contact-nombre-error"
              class={fieldClass}
            />
            <p id="contact-nombre-error" data-error-for="nombre" class={errorClass}></p>
          </div>
          <div>
            <label for="contact-email" class={labelClass}>Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              aria-describedby="contact-email-error"
              class={fieldClass}
            />
            <p id="contact-email-error" data-error-for="email" class={errorClass}></p>
          </div>
        </div>

        <div>
          <label for="contact-tipo" class={labelClass}>Tipo de proyecto</label>
          <div class="relative" data-enhance-select>
            <select
              id="contact-tipo"
              name="tipoProyecto"
              required
              aria-describedby="contact-tipo-error"
              class:list={[fieldClass, selectClass]}
            >
              <option value="" disabled selected>Elegí una opción</option>
              {PROJECT_TYPES.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <p id="contact-tipo-error" data-error-for="tipoProyecto" class={errorClass}></p>
        </div>

        <div>
          <label for="contact-mensaje" class={labelClass}>
            Mensaje <span class="text-muted normal-case tracking-normal font-normal">(opcional)</span>
          </label>
          <textarea
            id="contact-mensaje"
            name="mensaje"
            rows="5"
            aria-describedby="contact-mensaje-error"
            placeholder="Si querés, contanos qué necesitás y para cuándo."
            class:list={[fieldClass, 'resize-y min-h-[8rem]']}
          ></textarea>
          <p id="contact-mensaje-error" data-error-for="mensaje" class={errorClass}></p>
        </div>

        <!-- Honeypot: off-screen, out of tab order, hidden from assistive tech. -->
        <div aria-hidden="true" class="absolute -left-[9999px] top-auto w-px h-px overflow-hidden">
          <label for="contact-empresa-web">Empresa web (no completar)</label>
          <input id="contact-empresa-web" name="empresa_web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <button
            type="submit"
            id="contact-submit"
            data-label="Enviar consulta →"
            class="btn btn-primary text-[16px] tracking-[0.08em] uppercase px-[22px] py-[14px] disabled:opacity-60 disabled:cursor-not-allowed"
          >Enviar consulta →</button>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[16px] leading-[1.4] text-muted underline underline-offset-4 decoration-divider transition-colors duration-200 hover:text-text hover:decoration-accent"
          >O escribinos por WhatsApp ↗</a>
        </div>

        <div
          id="contact-error"
          role="alert"
          hidden
          class="border-l-2 border-accent pl-[clamp(12px,2vw,20px)] text-[clamp(14px,1.2vw,17px)] leading-[1.5]"
        >
          No pudimos enviar tu consulta. Escribinos directamente a{' '}
          <a href={`mailto:${contactEmail}`} class="text-accent underline underline-offset-4">{contactEmail}</a>.
        </div>
      </form>

      <div
        id="contact-success"
        role="status"
        tabindex="-1"
        hidden
        class="border-t-2 border-accent pt-[clamp(16px,2.4vw,28px)] focus-visible:outline-none"
      >
        <div class="text-accent text-[13px] tracking-[0.08em] uppercase font-semibold mb-3">Consulta enviada</div>
        <p class="m-0 text-[clamp(22px,3vw,44px)] leading-[1.1] tracking-[-0.03em] max-w-[22ch] font-heading font-extrabold">
          Recibimos tu consulta.
        </p>
        <p class="text-muted mt-3 mb-0 text-[clamp(15px,1.4vw,19px)] leading-[1.5] max-w-[46ch]">
          Te respondemos dentro de las 48 hs hábiles. Te enviamos una confirmación por mail.
        </p>
      </div>
    </div>

    <aside class="col-[1/13] grid grid-cols-1 border-[1.5px] border-text bg-white lg:grid-cols-12">
      <div class="flex flex-col gap-7 border-b-[1.5px] border-text p-[clamp(24px,3.4vw,52px)] lg:col-[1/8] lg:border-r-[1.5px]">
        <h2 class="m-0 font-stretch-expanded leading-[0.95] tracking-[-0.03em] uppercase">
          <span class="block text-[clamp(20px,2.6vw,40px)] font-black italic">A la altura de tu</span>
          <span class="block text-[clamp(56px,8.6vw,140px)] font-light tracking-[-0.04em]">Marca</span>
        </h2>
        <p class="m-0 max-w-[40ch] text-[16px] leading-[1.5] text-muted">Contanos qué querés construir. Una conversación no compromete a nada — respondemos dentro de las 48 hs hábiles.</p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary self-start justify-between gap-9 px-[22px] py-[18px] text-[13px] tracking-[0.16em] uppercase font-extrabold text-white"
        >Escribinos por WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
      <div data-reveal="scale" class="hidden items-center justify-center overflow-hidden p-6 lg:col-[8/13] lg:row-[1/3] lg:flex">
        <BrandMark mark="dark" class="h-[clamp(200px,26vw,380px)]" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:col-[1/8] lg:border-r-[1.5px] lg:border-text">
        {[
          { k: 'Celular', v: '+54 11 5479 3056', href: 'tel:+5491154793056' },
          { k: 'Instagram', v: '@estudiocounterpoint', href: 'https://instagram.com/estudiocounterpoint' },
          { k: 'Mail directo', v: contactEmail, href: `mailto:${contactEmail}` },
          { k: 'Oficina', v: 'Buenos Aires — San Isidro', href: '#contacto' },
        ].map((c) => (
          <a href={c.href} class="flex flex-col gap-2 border-b border-text px-[clamp(20px,2.4vw,36px)] py-[22px] text-text transition-colors duration-200 hover:bg-bg hover:text-text">
            <span class="text-[13px] tracking-[0.16em] uppercase font-bold text-muted">{c.k}</span>
            <span class="text-[clamp(16px,1.3vw,19px)] [overflow-wrap:anywhere]">{c.v}</span>
          </a>
        ))}
      </div>
      <div data-reveal="clip" class="sb-scope col-span-full h-[clamp(120px,19vw,270px)] overflow-hidden bg-white text-text" aria-hidden="true">
        <Sunburst width={1440} height={270} rays={28} twist={0.18} />
      </div>
    </aside>
  </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const errorBox = document.getElementById('contact-error') as HTMLElement;
    const successBox = document.getElementById('contact-success') as HTMLElement;
    const idleLabel = submitBtn.dataset.label ?? submitBtn.textContent ?? '';

    // Preselect the project type from `?tipo=` (links from /servicios). Only known values apply.
    const tipoSelect = form.elements.namedItem('tipoProyecto') as HTMLSelectElement | null;
    const tipoParam = new URLSearchParams(window.location.search).get('tipo');
    if (tipoSelect && tipoParam && Array.from(tipoSelect.options).some((o) => o.value === tipoParam && !o.disabled)) {
      tipoSelect.value = tipoParam;
      tipoSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Native validation stays as the no-JS fallback; with JS we render inline messages instead.
    form.noValidate = true;

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    const getField = (name: string) => form.elements.namedItem(name) as Field | null;
    const getErrorEl = (name: string) => form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    const setError = (name: string, message: string) => {
      const field = getField(name);
      const el = getErrorEl(name);
      if (el) el.textContent = message;
      if (field) {
        if (message) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      }
    };

    const validators: Record<string, (value: string, field: Field) => string> = {
      nombre: (v) => (v.trim() ? '' : 'Contanos tu nombre.'),
      email: (v, f) =>
        v.trim() && (f as HTMLInputElement).validity.valid ? '' : 'Ingresá un email válido.',
      tipoProyecto: (v) => (v ? '' : 'Elegí un tipo de proyecto.'),
    };

    const validateAll = () => {
      let firstInvalid: Field | null = null;
      for (const [name, validate] of Object.entries(validators)) {
        const field = getField(name);
        if (!field) continue;
        const message = validate(field.value, field);
        setError(name, message);
        if (message && !firstInvalid) firstInvalid = field;
      }
      return firstInvalid;
    };

    // Clear a field's error as soon as the user edits it.
    form.addEventListener('input', (e) => {
      const target = e.target as Field;
      if (target?.name && target.getAttribute('aria-invalid') === 'true') {
        const validate = validators[target.name];
        if (validate && !validate(target.value, target)) setError(target.name, '');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      const firstInvalid = validateAll();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          // Hold the column at the form's height while we scroll up to the section title,
          // then release it so the page doesn't collapse under the reader's viewport.
          const column = form.parentElement as HTMLElement;
          column.style.minHeight = `${column.offsetHeight}px`;
          const release = () => {
            column.style.minHeight = '';
          };

          form.hidden = true;
          successBox.hidden = false;
          successBox.focus({ preventScroll: true });

          const startY = window.scrollY;
          document.getElementById('contacto')?.scrollIntoView({ block: 'start' });

          // Release only once the scroll has actually settled; shrinking earlier
          // near the page bottom makes the browser clamp and cut the animation short.
          let last = startY;
          let moved = false;
          let stableTicks = 0;
          let ticks = 0;
          const timer = window.setInterval(() => {
            const y = window.scrollY;
            if (Math.abs(y - startY) >= 1) moved = true;
            stableTicks = Math.abs(y - last) < 1 ? stableTicks + 1 : 0;
            last = y;
            ticks += 1;
            if ((moved && stableTicks >= 6) || ticks > 60) {
              window.clearInterval(timer);
              release();
            }
          }, 50);
          return;
        }

        if (res.status === 400) {
          const body = await res.json().catch(() => null);
          const fieldErrors: Record<string, string[]> | undefined = body?.errors;
          if (fieldErrors) {
            let first: Field | null = null;
            for (const [name, messages] of Object.entries(fieldErrors)) {
              if (!messages?.length) continue;
              setError(name, messages[0]);
              first ??= getField(name);
            }
            if (first) {
              first.focus();
              return;
            }
          }
        }

        errorBox.hidden = false;
      } catch {
        errorBox.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = idleLabel;
      }
    });
  }
</script>
