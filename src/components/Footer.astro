---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import { whatsappUrl } from '../lib/whatsapp';
---

<footer class="overflow-hidden bg-text text-bg">
  <div class="mx-auto max-w-[1440px] px-[clamp(16px,4vw,56px)] pt-[clamp(48px,6vw,88px)] pb-7">
    <div class="grid grid-cols-1 gap-8 border-b border-bg/25 pb-10 text-[16px] leading-[1.8] sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="mb-2.5 text-[13px] tracking-[0.16em] uppercase font-bold text-bg/60">Índice</div>
        <a href="/#servicios" class="link-u block w-fit text-bg">Servicios</a>
        <a href="/#manifiesto" class="link-u block w-fit text-bg">Manifiesto</a>
        <a href="/#trabajo" class="link-u block w-fit text-bg">Trabajo seleccionado</a>
        <a href="/#proceso" class="link-u block w-fit text-bg">Proceso</a>
      </div>
      <div>
        <div class="mb-2.5 text-[13px] tracking-[0.16em] uppercase font-bold text-bg/60">Oficina</div>
        Buenos Aires — San Isidro<br />Argentina
      </div>
      <div>
        <div class="mb-2.5 text-[13px] tracking-[0.16em] uppercase font-bold text-bg/60">Contacto</div>
        <a href="mailto:proyectos@estudiocounterpoint.com" class="link-u block w-fit text-accent [overflow-wrap:anywhere]">proyectos@estudiocounterpoint.com</a>
        +54 11 5479 3056
      </div>
      <div>
        <div class="mb-2.5 text-[13px] tracking-[0.16em] uppercase font-bold text-bg/60">Redes</div>
        <a href="https://instagram.com/estudiocounterpoint" target="_blank" rel="noopener noreferrer" class="link-u block w-fit text-bg">@estudiocounterpoint</a>
      </div>
    </div>
    <div data-reveal="up" class="-ml-[0.04em] py-[clamp(28px,3vw,48px)] pb-[clamp(20px,2vw,32px)] font-heading font-black text-[min(10.2vw,142px)] leading-[0.8] tracking-[-0.05em] whitespace-nowrap">COUNTERPOINT<span class="text-accent">.</span></div>
    <div class="flex flex-wrap items-center justify-between gap-4 text-[14px] text-bg/60">
      <span>© 2026 Counterpoint. Un estudio a la altura de tu marca.</span>
      <span><a href="/privacidad" class="text-bg/60 transition-colors duration-200 hover:text-accent">Privacidad</a> — Buenas prácticas de accesibilidad</span>
      <span class="flex items-center gap-4">
        <a href={whatsappUrl('Hola, quiero hacer una consulta.')} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-bg transition-[color,scale,translate] duration-200 ease-snap hover:text-accent hover:-translate-y-0.5 active:scale-90">
          <WhatsAppIcon />
        </a>
        <a href="https://instagram.com/estudiocounterpoint" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-bg transition-[color,scale,translate] duration-200 ease-snap hover:text-accent hover:-translate-y-0.5 active:scale-90">
          <InstagramIcon />
        </a>
      </span>
    </div>
  </div>
</footer>
