    <div style="grid-column: 9 / 13; display: flex; align-items: flex-end; justify-content: flex-end;">
      <a href="#top" class="cta-sweep" style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(15px, 1.6vw, 22px); letter-spacing: -0.01em; color: var(--color-bg);"><span class="cta-sweep-label" data-text="Empezar la conversación →">Empezar la conversación →</span><span class="cta-sweep-underline"></span></a>
