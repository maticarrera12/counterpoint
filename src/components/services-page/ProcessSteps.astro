---
const steps = [
  {
    title: 'Entendemos el proyecto',
    body: 'Conocemos el negocio, sus objetivos, su público y las necesidades que debe resolver el sitio.',
  },
  {
    title: 'Definimos la dirección',
    body: 'Organizamos el contenido y establecemos el enfoque visual y funcional antes de avanzar con el desarrollo.',
  },
  {
    title: 'Diseñamos y desarrollamos',
    body: 'Transformamos esa dirección en una experiencia digital coherente, responsive y adaptada al proyecto.',
  },
  {
    title: 'Probamos y publicamos',
    body: 'Revisamos el funcionamiento, corregimos errores de entrega y dejamos el sitio listo para su lanzamiento.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<section data-reveal-title class="border-t-2 border-divider py-[clamp(36px,6vw,88px)] px-[clamp(16px,4vw,56px)]">
  <div class="text-[13px] tracking-[0.08em] uppercase font-semibold mb-[10px]">Proceso</div>
  <h2 class="m-0 text-[clamp(30px,5vw,78px)] leading-[0.94] tracking-[-0.04em] max-w-[18ch] uppercase">De la idea a una web bien resuelta.</h2>
  <p class="text-muted mt-3 mb-[clamp(24px,5vw,60px)] text-[clamp(15px,1.4vw,19px)] leading-[1.5] max-w-[56ch]">Cada proyecto tiene sus particularidades, pero trabajamos con un proceso claro para tomar decisiones y avanzar con criterio.</p>

  <ol data-reveal-stagger="110" class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border-t border-divider">
    {steps.map((step, i) => (
      <li data-reveal="up" class="py-[clamp(16px,2.4vw,28px)] border-b border-divider lg:border-b-0 lg:pr-[clamp(12px,2vw,28px)]">
        <div class="text-accent font-heading font-extrabold text-[13px] tracking-[0.08em] uppercase">{pad(i + 1)}</div>
        <h3 class="m-0 mt-2 text-[clamp(19px,2vw,26px)] leading-[1.1] tracking-[-0.02em]">{step.title}</h3>
        <p class="text-muted mt-3 mb-0 text-[clamp(14px,1.2vw,16px)] leading-[1.5] max-w-[34ch]">{step.body}</p>
      </li>
    ))}
  </ol>
</section>
