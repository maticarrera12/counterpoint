---
import ImgSlot from '../ImgSlot.astro';

const phrases = ['Diseño con intención', 'Código que se sostiene', 'La estética no es decoración'];
const repeats = 6;

const sequence = Array.from({ length: repeats }, () => phrases).flat();
---

<section id="top" class="relative overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-[clamp(90px,10vw,150px)] bg-text"></div>
  <div class="relative mx-auto grid max-w-[1440px] grid-cols-12 gap-x-[clamp(12px,1.6vw,24px)] px-[clamp(16px,4vw,56px)]">
    <div data-hero="1" class="col-[1/8] flex h-[clamp(90px,10vw,150px)] items-end justify-between gap-4 pb-4 text-[13px] leading-[1.7] tracking-[0.16em] uppercase font-semibold text-bg">
      <div class="whitespace-nowrap">Vol. 01<br /><span class="text-bg/60">Diseño &amp; código</span></div>
      <div class="hidden sm:block whitespace-nowrap text-right">Estudio indep.<br /><span class="text-bg/60">Buenos Aires</span></div>
    </div>

    <div class="hero-sun col-[9/13] row-[1/3] flex aspect-[1/1.02] flex-col items-center justify-center gap-[4%] self-start border-[1.5px] border-text bg-accent p-[8%] font-stretch-expanded font-light leading-[0.9] tracking-[-0.02em] text-[clamp(44px,9.4vw,150px)]" aria-hidden="true">
      <span class="text-text">20</span>
      <span class="h-0.5 w-[78%] bg-text"></span>
      <span class="text-white">26</span>
    </div>

    <h1 class="col-[1/9] row-start-2 m-0 pt-[clamp(32px,6vw,96px)] font-stretch-expanded text-[clamp(28px,6.5vw,104px)] leading-[0.94] tracking-[-0.035em] uppercase">
      <span class="hero-line"><span class="hero-line-i whitespace-nowrap font-light" style="--i:0">Nada es</span></span>
      <span class="hero-line"><span class="hero-line-i font-black" style="--i:1">Decorativo</span></span>
      <span class="hero-line"><span class="hero-line-i font-light" style="--i:2">Todo es</span></span>
      <span class="hero-line"><span class="hero-line-i font-black" style="--i:3">Delib<span class="text-accent">erado</span></span></span>
    </h1>

    <div class="hero-fig col-[9/13] row-start-3 flex flex-col gap-2.5 pt-[clamp(20px,2vw,32px)]">
      <div class="hero-img relative h-[clamp(180px,26vw,380px)] overflow-hidden grayscale contrast-[1.08]">
        <ImgSlot src="/img/tower.webp" alt="Fachada de un edificio en blanco y negro" fit="cover" width={700} height={1109} loading="eager">Foto B&amp;N — arquitectura brutalista</ImgSlot>
      </div>
      <div data-hero="2" class="flex justify-between gap-3 text-[13px] tracking-[0.04em] text-muted"><span>Fig. 01 — Estructura antes que estilo</span><span class="text-accent">↘</span></div>
    </div>

    <div data-hero="3" class="col-span-full mt-[clamp(32px,5vw,72px)] grid grid-cols-1 items-end gap-6 border-t-[1.5px] border-text pt-6 pb-[clamp(40px,6vw,88px)] md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]">
      <p class="m-0 max-w-[30ch] text-[clamp(18px,1.5vw,22px)] leading-[1.35] text-pretty">Diseñamos y desarrollamos sitios web para marcas que quieren verse —y funcionar— a la altura de lo que hacen.</p>
      <p class="m-0 text-[13px] leading-normal tracking-[0.16em] uppercase font-semibold text-muted">Para marcas que<br />no se conforman.</p>
      <a href="#contacto" data-hero="4" class="btn btn-primary w-full md:col-span-2 md:w-auto md:min-w-[300px] md:justify-self-end lg:col-auto justify-between gap-7 px-[22px] py-[18px] text-[13px] tracking-[0.16em] uppercase font-extrabold text-white">Contanos tu proyecto <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div data-hero="5" class="ticker">
    <div class="ticker-track">
      {[0, 1].map((copy) => (
        <div class="ticker-copy" aria-hidden={copy === 1}>
          {sequence.map((phrase) => (
            <>
              <span class="ticker-item">{phrase}</span>
              <span class="ticker-item ticker-mark">●</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Load sequence: pure CSS so it starts with first paint. Headline lines rise through masks,
     the figure is wiped open from the bottom while its image settles, the rest follows. */
  /* Structure (always on): each headline line sits in its own mask. */
  .hero-line { display: block; overflow: hidden; padding: 0.14em 0.12em; margin: -0.14em -0.12em; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line-i {
      animation: hero-rise 900ms var(--ease-snap) calc(120ms + var(--i, 0) * 90ms) backwards;
    }
    .hero-rule { transform-origin: 0 50%; animation: hero-rule 900ms var(--ease-move) 60ms backwards; }
    .hero-img { animation: hero-wipe 1100ms var(--ease-move) 380ms backwards; }
    .hero-img img { scale: 1.1; animation: hero-settle 1500ms var(--ease-snap) 380ms backwards; }
    [data-hero="1"] { animation: hero-fade 700ms var(--ease-snap) 0ms backwards; }
    [data-hero="2"] { animation: hero-up 700ms var(--ease-snap) 900ms backwards; }
    [data-hero="3"] { animation: hero-up 800ms var(--ease-snap) 650ms backwards; }
    [data-hero="4"] { animation: hero-up 800ms var(--ease-snap) 780ms backwards; }
    [data-hero="5"] { animation: hero-fade 900ms ease 1000ms backwards; }
    /* The 20/26 block opens like the photo: wiped up from the bottom, then its figures settle. */
    .hero-sun { animation: hero-wipe 1000ms var(--ease-move) 250ms backwards; }
    .hero-sun > span:first-child { animation: hero-up 700ms var(--ease-snap) 750ms backwards; }
    .hero-sun > span:nth-child(2) { transform-origin: 0 50%; animation: hero-rule 700ms var(--ease-move) 900ms backwards; }
    .hero-sun > span:last-child { animation: hero-up 700ms var(--ease-snap) 950ms backwards; }
  }

  /* The image drifts slowly against the scroll while the hero leaves (scroll-driven, transform-only). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-img img {
        animation:
          hero-settle 1500ms var(--ease-snap) 380ms backwards,
          hero-drift linear both;
        animation-timeline: auto, scroll(root block);
        animation-range: normal, 0px 100vh;
      }
    }
  }

  @keyframes hero-rise { from { transform: translate3d(-0.3em, 118%, 0); } }
  @keyframes hero-rule { from { transform: scaleX(0); } }
  @keyframes hero-wipe { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-settle { from { scale: 1.3; } }
  @keyframes hero-drift { from { translate: 0 0; } to { translate: 0 7%; } }
  @keyframes hero-up { from { opacity: 0; transform: translate3d(0, 18px, 0); } }
  @keyframes hero-fade { from { opacity: 0; } }

  .ticker {
    overflow: hidden;
    border-top: 1.5px solid var(--color-text);
    border-bottom: 1.5px solid var(--color-text);
    padding: 14px 0;
    /* Fade both ends so the text doesn't get cut off abruptly. Lives on the static wrapper: on the track it would scroll away. */
      }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: cp-ticker 38s linear infinite;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ticker-copy {
    display: flex;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }

  .ticker-item {
    padding-right: 40px;
    white-space: nowrap;
  }

  .ticker-mark {
    color: var(--ac);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
