---
import ImgSlot from '../ImgSlot.astro';

const phrases = ['Diseño con intención', 'Código que se sostiene', 'La estética no es decoración'];
const repeats = 6;

const sequence = Array.from({ length: repeats }, () => phrases).flat();
---

<section id="top" class="relative pt-[clamp(24px,5vw,64px)] px-[clamp(16px,4vw,56px)] pb-0">
  <div>
    <div data-hero="1" class="flex flex-col md:flex-row md:justify-between gap-x-[clamp(8px,1.6vw,22px)] gap-y-0">
      <div class="text-[13px] tracking-[0.08em] uppercase font-semibold ">Vol. 01<br><span class="text-muted hidden md:block">Diseño & Código&nbsp;/ sept. 2026</span></div>
      <div class="self-end md:self-auto text-[13px] tracking-[0.08em] uppercase font-semibold text-right">Estudio Independiente<br><span class="text-muted">Buenos Aires, Argentina</span></div>
    </div>
    <div class="hero-rule h-0.5 bg-divider mt-[clamp(10px,1.6vw,20px)] mb-[clamp(12px,2vw,26px)]"></div>
  </div>

  <div class="relative grid grid-cols-12 gap-x-[clamp(8px,1.6vw,22px)] gap-y-0 pt-20 md:pt-0">
    <h1 class="col-[1/12] row-start-1 m-0 text-[clamp(52px,13.2vw,178px)] leading-[0.84] tracking-[-0.045em] uppercase relative z-3 mix-blend-multiply">
      <span class="hero-line"><span class="hero-line-i whitespace-nowrap" style="--i:0">nada es</span></span>
      <span class="hero-line"><span class="hero-line-i inline-block" style="--i:1">decorativo</span></span>
      <span class="hero-line"><span class="hero-line-i" style="--i:2">todo es</span></span>
      <span class="hero-line"><span class="hero-line-i" style="--i:3">delib<span class="text-accent">erado.</span></span></span>
    </h1>
    <div class="hero-fig col-[8/13] row-start-1 self-center mt-[clamp(40px,9vw,120px)] relative z-1">
      <div class="hero-img relative w-full aspect-square overflow-hidden">
        <ImgSlot src="/img/tower.webp" alt="Fachada de un edificio en blanco y negro" fit="cover" width={700} height={1109} loading="eager">Conceptual: grilla tipográfica, sombra dura, masa abstracta</ImgSlot>
      </div>
      <div data-hero="2" class="text-[14px] tracking-[0.02em] mt-2 flex justify-between gap-3"><span class="text-muted">Fig 01 - Estructura antes que estilo</span><span class="text-accent">↘</span></div>
    </div>
  </div>

  <div class="grid pb:16 grid-cols-1 md:grid-cols-12 gap-y-[clamp(16px,3vw,32px)] gap-x-[clamp(8px,1.6vw,22px)] pt-[clamp(20px,4vw,52px)] pb-[clamp(28px,5vw,72px)] items-end">
    <div data-hero="3" class="flex flex-col gap-2 md:contents">
      <p class="md:col-[1/6] m-0 text-[clamp(16px,1.5vw,22px)] leading-[1.35] max-w-[34ch]">Diseñamos y desarrollamos sitios web para marcas que quieren verse —y funcionar— a la altura de lo que hacen.</p>
      <div class="text-muted md:col-[6/9] text-[14px] leading-normal tracking-[0.04em]">Para marcas que no se conforman.</div>
    </div>
    <div data-hero="4" class="md:col-[9/13] flex md:justify-end">
      <a href="#contacto" class="btn btn-primary w-full md:w-auto text-[13px] tracking-widest uppercase px-5.5 py-3.5"> Contanos tu proyecto →</a>
    </div>
  </div>

  <div data-hero="5" class="ticker">
    <div class="ticker-track">
      {[0, 1].map((copy) => (
        <div class="ticker-copy" aria-hidden={copy === 1}>
          {sequence.map((phrase) => (
            <>
              <span class="ticker-item">{phrase}</span>
              <span class="ticker-item ticker-mark">◆</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Load sequence: pure CSS so it starts with first paint. Headline lines rise through masks,
     the figure is wiped open from the bottom while its image settles, the rest follows. */
  /* Structure (always on): each headline line sits in its own mask. */
  .hero-line { display: block; overflow: hidden; padding: 0.14em 0.12em; margin: -0.14em -0.12em; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line-i {
      animation: hero-rise 900ms var(--ease-snap) calc(120ms + var(--i, 0) * 90ms) backwards;
    }
    .hero-rule { transform-origin: 0 50%; animation: hero-rule 900ms var(--ease-move) 60ms backwards; }
    .hero-img { animation: hero-wipe 1100ms var(--ease-move) 380ms backwards; }
    .hero-img img { scale: 1.1; animation: hero-settle 1500ms var(--ease-snap) 380ms backwards; }
    [data-hero="1"] { animation: hero-fade 700ms var(--ease-snap) 0ms backwards; }
    [data-hero="2"] { animation: hero-up 700ms var(--ease-snap) 900ms backwards; }
    [data-hero="3"] { animation: hero-up 800ms var(--ease-snap) 650ms backwards; }
    [data-hero="4"] { animation: hero-up 800ms var(--ease-snap) 780ms backwards; }
    [data-hero="5"] { animation: hero-fade 900ms ease 1000ms backwards; }
  }

  /* The image drifts slowly against the scroll while the hero leaves (scroll-driven, transform-only). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-img img {
        animation:
          hero-settle 1500ms var(--ease-snap) 380ms backwards,
          hero-drift linear both;
        animation-timeline: auto, scroll(root block);
        animation-range: normal, 0px 100vh;
      }
    }
  }

  @keyframes hero-rise { from { transform: translate3d(-0.3em, 118%, 0); } }
  @keyframes hero-rule { from { transform: scaleX(0); } }
  @keyframes hero-wipe { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-settle { from { scale: 1.3; } }
  @keyframes hero-drift { from { translate: 0 0; } to { translate: 0 7%; } }
  @keyframes hero-up { from { opacity: 0; transform: translate3d(0, 18px, 0); } }
  @keyframes hero-fade { from { opacity: 0; } }

  .ticker {
    overflow: hidden;
    border-top: 2px solid var(--color-divider);
    padding: 7px 0;
    /* Fade both ends so the text doesn't get cut off abruptly. Lives on the static wrapper: on the track it would scroll away. */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: cp-ticker 38s linear infinite;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .ticker-copy {
    display: flex;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }

  .ticker-item {
    padding-right: 40px;
    white-space: nowrap;
  }

  .ticker-mark {
    color: var(--ac);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
