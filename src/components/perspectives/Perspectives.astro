---
import ImgSlot from '../ImgSlot.astro';
---

<section id="perspectivas" class="bg-text text-bg pt-[clamp(40px,7vw,96px)] px-[clamp(16px,4vw,56px)] pb-[clamp(48px,8vw,110px)]">
  <div class="grid grid-cols-12 gap-y-[clamp(16px,3vw,34px)] gap-x-[clamp(8px,1.6vw,22px)] items-end border-b-2 border-bg/35 pb-[clamp(14px,2.4vw,26px)]">
    <div class="col-[1/8]">
      <div class="text-[11px] tracking-[0.14em] uppercase font-semibold opacity-60">04 / Perspectivas seleccionadas</div>
      <h2 class="mt-[10px] mb-0 text-[clamp(30px,5vw,78px)] leading-[0.92] tracking-[-0.04em]">Los Papers de<br>CounterPoint</h2>
    </div>
    <div class="col-[9/13] text-[11px] leading-[1.6] opacity-70 text-right">Un registro trimestral de lo que<br>discutimos puertas adentro.<br><span class="text-accent">Archivo 001—024</span></div>
  </div>

  <article class="grid grid-cols-12 gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] py-[clamp(22px,4vw,48px)] border-b border-bg/28 items-center">
    <div class="col-[1/3] text-accent font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">001</div>
    <h3 class="col-[3/9] m-0 text-[clamp(24px,3.6vw,54px)] leading-[0.98] tracking-[-0.03em]">El costo del diseño sin sistema.</h3>
    <div class="col-[9/11] text-[11px] tracking-[0.1em] uppercase opacity-65">Ensayo<br>04.26</div>
    <div class="col-[11/13] relative h-[clamp(70px,9vw,130px)]">
      <ImgSlot dark src="/img/metalmecanica.webp" alt="Metalmecánica">Abstracto: grilla rota, alto contraste</ImgSlot>
    </div>
  </article>

  <article class="grid grid-cols-12 gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] py-[clamp(22px,4vw,48px)] border-b border-bg/28 items-center">
    <div class="col-[1/4] relative h-[clamp(90px,12vw,180px)]">
      <ImgSlot dark src="/img/agroquimicos.webp" alt="Agroquímicos">Abstracto: tipografía fragmentada</ImgSlot>
    </div>
    <div class="col-[4/6] font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">002</div>
    <h3 class="col-[6/12] m-0 text-[clamp(24px,3.6vw,54px)] leading-[0.98] tracking-[-0.03em]">Por qué la mayoría de los rediseños fracasan antes de lanzar.</h3>
    <div class="col-[12/13] text-[11px] tracking-[0.1em] uppercase opacity-65 [writing-mode:vertical-rl]">Nota de campo — 02.26</div>
  </article>

  <article class="grid grid-cols-12 gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] pt-[clamp(22px,4vw,48px)] pb-0 items-start">
    <div class="col-[1/7] text-[11px] tracking-[0.1em] uppercase opacity-65">Lectura extensa — 11.25 / 4.200 palabras</div>
    <div class="col-[7/9] text-accent font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">003</div>
    <h3 class="col-[1/10] m-0 text-[clamp(26px,4.6vw,72px)] leading-[0.94] tracking-[-0.035em]">La incómoda ventaja de programar tu propio diseño.</h3>
    <a href="#top" class="col-[10/13] self-end text-accent text-[11px] tracking-[0.14em] uppercase font-semibold text-right">Ver el archivo →</a>
  </article>
</section>
