---
import ImgSlot from '../ImgSlot.astro';
---

<section id="perspectivas" data-grow data-reveal-title class="bg-text text-bg pt-20 md:pt-[clamp(40px,7vw,96px)] px-[clamp(16px,4vw,56px)] mb-20px pb-[clamp(48px,8vw,110px)]">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-y-[clamp(16px,3vw,34px)] gap-x-[clamp(8px,1.6vw,22px)] md:items-end border-b-2 border-bg/35 pb-[clamp(14px,2.4vw,26px)]">
    <div class="md:col-[1/8]">
      <div class="text-[11px] tracking-[0.14em] uppercase font-semibold opacity-60">04 / Perspectivas seleccionadas</div>
      <h2 class="mt-[10px] mb-0 text-[clamp(30px,5vw,78px)] leading-[0.92] tracking-[-0.04em] uppercas">Los Cuadernos de<br>CounterPoint</h2>
    </div>
    <div class="md:col-[9/13] text-[11px] leading-[1.6] opacity-70 md:text-right">Ideas, decisiones y criterio. Por escrito. <br> <span class="text-accent">Archivo 001—024</span></div>
  </div>

  <article class="grid grid-cols-1 md:grid-cols-12 gap-y-3 md:gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] py-[clamp(22px,4vw,48px)] border-b border-bg/28 md:items-center">
    <div class="flex items-baseline gap-4 md:contents">
      <div class="md:col-[1/3] md:row-start-1 text-accent font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">001</div>
      <div class="md:col-[9/11] md:row-start-1 text-[11px] tracking-[0.1em] uppercase opacity-65">Ensayo<br>04.26</div>
    </div>
    <h3 class="md:col-[3/9] md:row-start-1 m-0 text-[clamp(24px,3.6vw,54px)] leading-[0.98] tracking-[-0.03em]">
      <a href="/perspectivas/001-el-costo-del-diseno-sin-sistema" class="text-bg hover:text-accent transition-colors duration-300">El costo del diseño sin sistema.</a>
    </h3>
    <div class="md:col-[11/13] md:row-start-1 relative h-32 md:h-[clamp(70px,9vw,130px)]">
      <ImgSlot dark src="/img/metalmecanica.webp" alt="Metalmecánica" width={1600} height={1446}>Abstracto: grilla rota, alto contraste</ImgSlot>
    </div>
  </article>

  <article class="grid grid-cols-1 md:grid-cols-12 gap-y-3 md:gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] py-[clamp(22px,4vw,48px)] border-b border-bg/28 md:items-center">
    <div class="md:col-[1/4] md:row-start-1 relative h-40 md:h-[clamp(90px,12vw,180px)]">
      <ImgSlot dark src="/img/agroquimicos.webp" alt="Agroquímicos" width={298} height={488}>Abstracto: tipografía fragmentada</ImgSlot>
    </div>
    <div class="md:col-[4/6] md:row-start-1 font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">002</div>
    <div class="md:col-[6/12] md:row-start-1">
      <div class="mb-1 inline-block text-accent text-[10px] tracking-[0.14em] uppercase font-semibold">Próximamente</div>
      <h3 class="m-0 text-[clamp(24px,3.6vw,54px)] leading-[0.98] tracking-[-0.03em] line-through text-bg/50">Por qué la mayoría de los rediseños fracasan antes de lanzar.</h3>
    </div>
  </article>

  <article class="grid grid-cols-1 md:grid-cols-12 gap-y-3 md:gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] pt-[clamp(22px,4vw,48px)] pb-0 md:items-start">
    <div class="flex items-baseline gap-4 md:contents">
      <div class="md:col-[7/9] md:row-start-1 text-accent font-heading font-extrabold text-[clamp(30px,4.4vw,62px)] leading-[0.85]">003</div>
      <div class="md:col-[1/7] md:row-start-1 text-[11px] tracking-[0.1em] uppercase opacity-65">Lectura extensa — 11.25 / 4.200 palabras</div>
    </div>
    <div class="md:col-[1/10] md:row-start-2">
      <div class="mb-1 inline-block text-accent text-[10px] tracking-[0.14em] uppercase font-semibold">Próximamente</div>
      <h3 class="m-0 text-[clamp(26px,4.6vw,72px)] leading-[0.94] tracking-[-0.035em] line-through text-bg/50">La incómoda ventaja de programar tu propio diseño.</h3>
    </div>
    <a href="/perspectivas" class="md:col-[10/13] md:row-start-2 md:self-end text-accent text-[11px] tracking-[0.14em] uppercase font-semibold md:text-right">Ver el archivo →</a>
  </article>
</section>
