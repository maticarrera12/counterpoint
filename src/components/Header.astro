---
import BrandMark from './BrandMark.astro';

const linkClass =
  'relative after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-full after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-snap hover:after:origin-left hover:after:scale-x-100';
---

<div id="site-chrome" class="sticky top-0 z-40">
  <div class="scroll-progress" aria-hidden="true"></div>
  <header id="site-header" class="bg-text text-bg transition-transform duration-[240ms] ease-snap will-change-transform">
    <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-[clamp(16px,4vw,56px)]">
      <a href="/#top" class="flex items-center gap-2.5 text-bg hover:text-bg">
        <BrandMark mark="light" class="h-8" />
        <span class="font-stretch-expanded text-[13px] font-extrabold tracking-[0.02em] uppercase">Counterpoint</span>
      </a>
      <nav class="hidden md:flex items-center justify-end gap-[clamp(12px,2vw,36px)] whitespace-nowrap text-[13px] tracking-[0.16em] uppercase font-semibold">
        <a href="/#servicios" class:list={[linkClass, 'text-bg hover:text-bg']}>Servicios</a>
        <a href="/#manifiesto" class:list={[linkClass, 'text-bg hover:text-bg']}>Manifiesto</a>
        <a href="/#trabajo" class:list={[linkClass, 'text-bg hover:text-bg']}>Trabajo</a>
        <a href="/#proceso" class:list={[linkClass, 'hidden lg:inline text-bg hover:text-bg']}>Proceso</a>
        <span class="hidden lg:inline tabular-nums text-bg/60">BUE <span id="bue-clock">--:--</span></span>
        <a href="/#contacto" class:list={[linkClass, 'text-accent']}>Consultar →</a>
      </nav>
    </div>
  </header>
</div>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    const threshold = 8;

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const delta = y - lastY;

        if (Math.abs(delta) < threshold) return;

        if (delta > 0 && y > header.offsetHeight) {
          header.style.transform = 'translateY(-100%)';
        } else {
          header.style.transform = 'translateY(0)';
        }

        lastY = y;
      },
      { passive: true }
    );
  }

  const clock = document.getElementById('bue-clock');
  if (clock) {
    const format = new Intl.DateTimeFormat('es-AR', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'America/Argentina/Buenos_Aires',
    });
    const tick = () => {
      clock.textContent = format.format(new Date());
    };
    tick();
    window.setInterval(tick, 15000);
  }
</script>
