<div class="sticky top-0 z-40">
  <header id="site-header" class="bg-bg border-b-2 border-divider grid grid-cols-[1fr_auto] items-end gap-4 pt-[10px] px-[clamp(16px,4vw,56px)] pb-2 transition-transform duration-[250ms] ease-[ease] will-change-transform">
    <a href="#top" class="font-heading font-extrabold text-[clamp(15px,1.6vw,21px)] tracking-[-0.03em] uppercase leading-none">CounterPoint<span class="text-accent">.</span></a>
    <nav class=" hidden md:flex flex-wrap gap-[clamp(10px,2vw,28px)] text-[11px] tracking-[0.14em] uppercase font-semibold">
      <a href="#manifiesto">Manifiesto</a>
      <a href="#servicios">Servicios</a>
      <a href="#perspectivas">Perspectivas</a>
      <a href="#trabajo">Trabajo</a>
      <a href="#contacto" class="text-accent">Consultar</a>
    </nav>
  </header>
</div>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    const threshold = 8;

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const delta = y - lastY;

        if (Math.abs(delta) < threshold) return;

        if (delta > 0 && y > header.offsetHeight) {
          header.style.transform = 'translateY(-100%)';
        } else {
          header.style.transform = 'translateY(0)';
        }

        lastY = y;
      },
      { passive: true }
    );
  }
</script>
