<div style="position: sticky; top: 0; z-index: 40;">
  <header id="site-header" style="background: var(--color-bg); border-bottom: 2px solid var(--color-divider); display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 16px; padding: 10px clamp(16px, 4vw, 56px) 8px; transition: transform 0.25s ease; will-change: transform;">
    <a href="#top" style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(15px, 1.6vw, 21px); letter-spacing: -0.03em; text-transform: uppercase; line-height: 1;">CounterPoint<span style="color: var(--ac);">.</span></a>
    <nav style="display: flex; flex-wrap: wrap; gap: clamp(10px, 2vw, 28px); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600;">
      <a href="#manifiesto">Manifiesto</a>
      <a href="#desafio">Desafío</a>
      <a href="#perspectivas">Perspectivas</a>
      <a href="#trabajo">Trabajo</a>
      <a href="#contacto" style="color: var(--ac);">Consultar</a>
    </nav>
  </header>
</div>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    const threshold = 8;

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const delta = y - lastY;

        if (Math.abs(delta) < threshold) return;

        if (delta > 0 && y > header.offsetHeight) {
          header.style.transform = 'translateY(-100%)';
        } else {
          header.style.transform = 'translateY(0)';
        }

        lastY = y;
      },
      { passive: true }
    );
  }
</script>
