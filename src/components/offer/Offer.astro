---
const items = [
  {
    num: '01',
    title: 'Landing pages',
    description: 'Para presentar un servicio, producto o campaña y convertir visitas en consultas.',
    href: '/servicios#landing-pages',
    list: ['Estructura', 'Redacción', 'Dirección visual', 'Desarrollo responsive'],
  },
  {
    num: '02',
    title: 'Sitios institucionales',
    description: 'Sitios que expresan la identidad de una empresa y construyen presencia digital sólida.',
    href: '/servicios#sitios-institucionales',
    list: ['Arquitectura de contenidos', 'Identidad digital', 'SEO técnico', 'Autogestión'],
  },
  {
    num: '03',
    title: 'Rediseño web',
    description: 'Repensamos sitios existentes para que comuniquen mejor y funcionen con más claridad.',
    href: '/servicios#rediseno-web',
    list: ['Auditoría', 'Reestructura', 'Performance', 'Migración'],
  },
];
---

<section id="servicios" data-reveal-title class="py-[clamp(72px,9vw,140px)]">
  <div class="mx-auto max-w-[1440px] px-[clamp(16px,4vw,56px)]">
    <div class="grid grid-cols-1 items-end gap-6 pb-[clamp(40px,5vw,72px)] md:grid-cols-3">
      <div data-reveal="fade" class="flex gap-10 text-[13px] tracking-[0.16em] uppercase font-bold"><span>01</span><span class="text-muted">Qué hacemos</span></div>
      <h2 class="m-0 font-stretch-expanded text-[clamp(26px,3vw,44px)] leading-none tracking-[-0.03em] uppercase md:col-span-2"><span class="font-light">Tres formatos. </span><span class="font-black">Un mismo criterio.</span></h2>
    </div>
    {items.map((item, i) => (
      <a
        href={item.href}
        class="group grid grid-cols-1 items-start gap-[clamp(20px,3vw,48px)] border-t-[1.5px] border-text py-[clamp(28px,3vw,44px)] text-text transition-colors duration-300 ease-snap hover:bg-surface hover:text-text md:grid-cols-[0.9fr_1.4fr_0.9fr]"
      >
        <div data-reveal="up" style={`--rd:${i * 80}ms`} class="font-stretch-expanded font-black text-accent text-[clamp(96px,13vw,210px)] transition-transform duration-300 ease-snap group-hover:translate-x-2 leading-[0.78] tracking-[-0.06em]">{item.num}</div>
        <div data-reveal="up" style={`--rd:${i * 80 + 80}ms`} class="flex flex-col gap-[22px]">
          <h3 class="m-0 font-stretch-expanded font-black text-[clamp(28px,2.8vw,44px)] leading-[0.95] tracking-[-0.04em] uppercase"><span class="hl-sweep">{item.title}</span></h3>
          <p class="m-0 max-w-[34ch] text-[clamp(17px,1.4vw,20px)] leading-[1.4] text-pretty">{item.description}</p>
        </div>
        <ul data-reveal="up" style={`--rd:${i * 80 + 160}ms`} class="m-0 flex list-none flex-col gap-2 p-0 font-stretch-expanded text-[14px] tracking-[0.01em] uppercase">
          {item.list.map((it) => (
            <li class="flex items-center gap-2">{it}<span class="size-[5px] rounded-full bg-accent"></span></li>
          ))}
        </ul>
      </a>
    ))}
    <div class="border-t-[1.5px] border-text"></div>
  </div>
</section>
