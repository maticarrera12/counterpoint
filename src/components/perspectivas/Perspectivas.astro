---
import ImgSlot from '../ImgSlot.astro';
---

<section id="perspectivas" style="background: var(--color-text); color: var(--color-bg); padding: clamp(40px, 7vw, 96px) clamp(16px, 4vw, 56px) clamp(48px, 8vw, 110px);">
  <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(16px, 3vw, 34px) clamp(8px, 1.6vw, 22px); align-items: end; border-bottom: 2px solid rgba(243,242,242,0.35); padding-bottom: clamp(14px, 2.4vw, 26px);">
    <div style="grid-column: 1 / 8;">
      <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; opacity: 0.6;">04 / Perspectivas seleccionadas</div>
      <h2 style="margin: 10px 0 0; font-size: clamp(30px, 5vw, 78px); line-height: 0.92; letter-spacing: -0.04em;">Los Papers de<br>CounterPoint</h2>
    </div>
    <div style="grid-column: 9 / 13; font-size: 11px; line-height: 1.6; opacity: 0.7; text-align: right;">Un registro trimestral de lo que<br>discutimos puertas adentro.<br><span style="color: var(--color-accent-500);">Archivo 001—024</span></div>
  </div>

  <article style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px) clamp(8px, 1.6vw, 22px); padding: clamp(22px, 4vw, 48px) 0; border-bottom: 1px solid rgba(243,242,242,0.28); align-items: center;">
    <div style="grid-column: 1 / 3; font-family: var(--font-heading); font-weight: 800; font-size: clamp(30px, 4.4vw, 62px); line-height: 0.85; color: var(--color-accent-500);">001</div>
    <h3 style="grid-column: 3 / 9; margin: 0; font-size: clamp(24px, 3.6vw, 54px); line-height: 0.98; letter-spacing: -0.03em;">El costo del diseño sin sistema.</h3>
    <div style="grid-column: 9 / 11; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.65;">Ensayo<br>04.26</div>
    <div style="grid-column: 11 / 13; height: clamp(70px, 9vw, 130px); position: relative;">
      <ImgSlot dark src="/img/perspectiva-001-grilla-rota.svg" alt="Grilla interrumpida de alto contraste">Abstracto: grilla rota, alto contraste</ImgSlot>
    </div>
  </article>

  <article style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px) clamp(8px, 1.6vw, 22px); padding: clamp(22px, 4vw, 48px) 0; border-bottom: 1px solid rgba(243,242,242,0.28); align-items: center;">
    <div style="grid-column: 1 / 4; height: clamp(90px, 12vw, 180px); position: relative;">
      <ImgSlot dark src="/img/perspectiva-002-fragmentada.svg" alt="Tipografía fragmentada en bloques desplazados">Abstracto: tipografía fragmentada</ImgSlot>
    </div>
    <div style="grid-column: 4 / 6; font-family: var(--font-heading); font-weight: 800; font-size: clamp(30px, 4.4vw, 62px); line-height: 0.85;">002</div>
    <h3 style="grid-column: 6 / 12; margin: 0; font-size: clamp(24px, 3.6vw, 54px); line-height: 0.98; letter-spacing: -0.03em;">Por qué la mayoría de los rediseños fracasan antes de lanzar.</h3>
    <div style="grid-column: 12 / 13; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.65; writing-mode: vertical-rl;">Nota de campo — 02.26</div>
  </article>

  <article style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px) clamp(8px, 1.6vw, 22px); padding: clamp(22px, 4vw, 48px) 0 0; align-items: start;">
    <div style="grid-column: 1 / 7; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.65;">Lectura extensa — 11.25 / 4.200 palabras</div>
    <div style="grid-column: 7 / 9; font-family: var(--font-heading); font-weight: 800; font-size: clamp(30px, 4.4vw, 62px); line-height: 0.85; color: var(--color-accent-500);">003</div>
    <h3 style="grid-column: 1 / 10; margin: 0; font-size: clamp(26px, 4.6vw, 72px); line-height: 0.94; letter-spacing: -0.035em;">La incómoda ventaja de programar tu propio diseño.</h3>
    <a href="#top" style="grid-column: 10 / 13; align-self: end; color: var(--color-accent-500); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; text-align: right;">Ver el archivo →</a>
  </article>
</section>
