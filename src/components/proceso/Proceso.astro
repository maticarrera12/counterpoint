<section style="border-top: 2px solid var(--color-divider); padding: clamp(48px, 8vw, 120px) clamp(16px, 4vw, 56px); position: relative;">
  <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600;">07 / Cómo avanza el trabajo</div>
  <div style="position: relative; margin-top: clamp(24px, 5vw, 60px);">
    <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px);">
      <div style="grid-column: 1 / 7; border-bottom: 1px solid var(--color-divider); padding-bottom: clamp(20px, 4vw, 44px);">
        <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(32px, 5.4vw, 84px); line-height: 0.9; letter-spacing: -0.04em;">Observar</div>
        <div style="font-size: clamp(13px, 1.15vw, 16px); line-height: 1.45; margin-top: 8px; max-width: 34ch;" class="text-muted">Antes del brief. Antes del Figma. Meternos dentro del producto tal como se usa de verdad.</div>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); margin-top: clamp(18px, 3vw, 40px);">
      <div style="grid-column: 5 / 12; border-bottom: 1px solid var(--color-divider); padding-bottom: clamp(20px, 4vw, 44px);">
        <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(32px, 5.4vw, 84px); line-height: 0.9; letter-spacing: -0.04em; color: var(--ac);">Preguntar</div>
        <div style="font-size: clamp(13px, 1.15vw, 16px); line-height: 1.45; margin-top: 8px; max-width: 36ch;" class="text-muted">La frase más cara de un diseño es <span style="color: var(--color-text);">«así se ve mejor»</span>.</div>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); margin-top: clamp(18px, 3vw, 40px);">
      <div style="grid-column: 2 / 9; border-bottom: 1px solid var(--color-divider); padding-bottom: clamp(20px, 4vw, 44px);">
        <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(32px, 5.4vw, 84px); line-height: 0.9; letter-spacing: -0.04em;">Replantear</div>
        <div style="font-size: clamp(13px, 1.15vw, 16px); line-height: 1.45; margin-top: 8px; max-width: 34ch;" class="text-muted">Un problema planteado de otra forma suele ser un problema medio resuelto.</div>
      </div>
      <div style="grid-column: 10 / 13; align-self: center; writing-mode: vertical-rl; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 600;" class="text-muted">No lineal, por diseño</div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); margin-top: clamp(18px, 3vw, 40px);">
      <div style="grid-column: 7 / 13; border-bottom: 1px solid var(--color-divider); padding-bottom: clamp(20px, 4vw, 44px); text-align: right;">
        <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(32px, 5.4vw, 84px); line-height: 0.9; letter-spacing: -0.04em;">Decidir</div>
        <div style="font-size: clamp(13px, 1.15vw, 16px); line-height: 1.45; margin-top: 8px; margin-left: auto; max-width: 34ch;" class="text-muted">No es consenso. Es una postura, con el razonamiento a la vista y el riesgo nombrado.</div>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 clamp(8px, 1.6vw, 22px); margin-top: clamp(18px, 3vw, 40px);">
      <div style="grid-column: 1 / 6; padding-bottom: clamp(8px, 2vw, 20px);">
        <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(32px, 5.4vw, 84px); line-height: 0.9; letter-spacing: -0.04em;">Actuar<span style="color: var(--ac);">.</span></div>
        <div style="font-size: clamp(13px, 1.15vw, 16px); line-height: 1.45; margin-top: 8px; max-width: 34ch;" class="text-muted">Nos quedamos hasta que el sitio está en producción, no hasta el mockup final.</div>
      </div>
    </div>
  </div>
</section>
