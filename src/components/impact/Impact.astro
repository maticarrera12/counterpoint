<section data-grow class="relative overflow-hidden bg-bg -mb-px mt:10 pt-20 md:pt-[clamp(48px,8vw,120px)] px-[clamp(16px,4vw,56px)] pb-20 md:pb-[clamp(40px,7vw,100px)]">
