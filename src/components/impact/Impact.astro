---
const stats = [
  {
    value: '10',
    suffix: '+',
    anim: 'rise',
    title: 'Proyectos entregados',
    text: 'Sitios y productos digitales, con acompañamiento después del lanzamiento.',
  },
  {
    value: '3',
    suffix: '',
    anim: 'drop',
    title: 'Años de experiencia',
    text: 'Formación técnica y experiencia en el mercado digital.',
  },
  {
    value: '100',
    suffix: '%',
    anim: 'wipe',
    title: 'Clientes satisfechos',
    text: 'Compromiso con cada proyecto y atención en cada etapa.',
  },
];
---

<section data-reveal-title class="bg-accent text-text">
  <div class="mx-auto max-w-[1440px] px-[clamp(16px,4vw,56px)] py-[clamp(64px,8vw,120px)]">
    <div class="grid grid-cols-1 items-end gap-6 border-b-[1.5px] border-text pb-[clamp(40px,5vw,72px)] md:grid-cols-3">
      <div data-reveal="fade" class="flex gap-10 text-[13px] tracking-[0.16em] uppercase font-bold"><span>04</span><span>Impacto</span></div>
      <h2 class="m-0 font-stretch-expanded text-[clamp(28px,3.6vw,56px)] leading-none tracking-[-0.04em] uppercase md:col-span-2"><span class="font-light">Experiencia que se transforma en </span><span class="font-black text-white">resultados.</span></h2>
    </div>
    <div class="grid grid-cols-1 gap-[1.5px] bg-text md:grid-cols-3">
      {stats.map((s, i) => (
        <div data-imp-row class="flex min-w-0 flex-col gap-[18px] bg-accent py-[clamp(28px,3vw,44px)] pr-[clamp(16px,2vw,32px)] pb-2 md:pl-[clamp(16px,2vw,32px)] md:first:pl-0">
          <div class:list={['font-stretch-expanded font-black whitespace-nowrap text-[clamp(56px,7.4vw,150px)] leading-[0.85] tracking-[-0.06em]', s.anim !== 'wipe' && 'imp-mask']}>
            <span data-imp={s.anim} style={`--d:${i * 120}ms`} class="inline-block">{s.value}{s.suffix && <span data-imp={s.anim === 'rise' ? 'pop' : undefined} style="--d:260ms" class="inline-block text-white">{s.suffix}</span>}</span>
          </div>
          <h3 class="m-0 text-[13px] tracking-[0.16em] uppercase font-bold">{s.title}</h3>
          <p data-imp="from-left" style={`--d:${300 + i * 120}ms`} class="m-0 max-w-[30ch] text-[15px] leading-[1.5]">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
