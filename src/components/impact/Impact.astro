---
const stats = [
  {
    value: '10',
    suffix: '+',
    anim: 'rise',
    title: 'Proyectos entregados',
    text: 'Sitios y productos digitales, con acompañamiento después del lanzamiento.',
  },
  {
    value: '3',
    suffix: '',
    anim: 'drop',
    title: 'Años de experiencia',
    text: 'Formación técnica y experiencia en el mercado digital.',
  },
  {
    value: '100',
    suffix: '%',
    anim: 'wipe',
    title: 'Clientes satisfechos',
    text: 'Compromiso con cada proyecto y atención en cada etapa.',
  },
];
---

<section data-grow class="relative overflow-hidden bg-bg -mb-px mt:10 pt-20 md:pt-[clamp(48px,8vw,120px)] px-[clamp(16px,4vw,56px)] pb-20 md:pb-[clamp(40px,7vw,100px)]">
  <div class="grid grid-cols-12 gap-x-[clamp(8px,1.6vw,22px)]">
    <div class="col-[1/2] text-[13px] tracking-[0.08em] uppercase font-semibold">03</div>
    <div class="text-muted col-[2/5] text-[13px] tracking-[0.08em] uppercase font-semibold">Impacto</div>
  </div>

  <h2 class="mt-[clamp(28px,5vw,64px)] mb-[clamp(32px,5vw,72px)] max-w-[18ch] text-[clamp(34px,6vw,96px)] leading-[0.92] tracking-[-0.04em]">
    Experiencia que se transforma en resultados.
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3">
    {stats.map((s, i) => (
      <div
        data-imp-row
        class:list={[
          'flex flex-col gap-3 py-[clamp(20px,3vw,40px)]',
          i > 0 && 'border-t-2 md:border-t-0 md:border-l-2 border-divider md:pl-[clamp(16px,2.4vw,40px)]',
          i < 2 && 'md:pr-[clamp(16px,2.4vw,40px)]',
        ]}
      >
        <div class:list={['font-heading font-extrabold text-[clamp(80px,11vw,176px)] leading-[0.95] tracking-[-0.06em]', s.anim !== 'wipe' && 'imp-mask']}>
          <span data-imp={s.anim} style={`--d:${i * 120}ms`} class="inline-block">{s.value}{s.suffix && <span data-imp={s.anim === 'rise' ? 'pop' : undefined} style="--d:260ms" class="inline-block text-accent">{s.suffix}</span>}</span>
        </div>
        <h3 class="m-0 text-[clamp(18px,1.8vw,26px)] leading-[1.15] tracking-[-0.02em]">{s.title}</h3>
        <p data-imp="from-left" style={`--d:${300 + i * 120}ms`} class="text-muted m-0 max-w-[30ch] text-[clamp(16px,1.4vw,20px)] leading-[1.4]">{s.text}</p>
      </div>
    ))}
  </div>
</section>
