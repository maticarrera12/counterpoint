---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import Offer from '../components/offer/Offer.astro';
import BigCTA from '../components/big-cta/BigCTA.astro';
import SelectedWork from '../components/selected-work/SelectedWork.astro';
import CaseStudy from '../components/case-study/CaseStudy.astro';
import Manifesto from '../components/manifesto/Manifesto.astro';
import Impact from '../components/impact/Impact.astro';
import Process from '../components/process/Process.astro';
import Contact from '../components/contact/Contact.astro';

// Single place to fill in: both show up in the JSON-LD below.
const EMAIL = 'proyectos@estudiocounterpoint.com';
const LOCALIDAD = 'San Isidro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'CounterPoint',
  url: 'https://estudiocounterpoint.com',
  logo: 'https://estudiocounterpoint.com/favicon.ico',
  description: 'Estudio de diseño y desarrollo web en Buenos Aires, Argentina.',
  email: EMAIL,
  areaServed: 'AR',
  address: {
    '@type': 'PostalAddress',
    addressLocality: LOCALIDAD,
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
};
---

<Layout
  title="CounterPoint — Estudio de diseño y desarrollo web"
  description="Diseñamos y desarrollamos landing pages, sitios institucionales y rediseño web para marcas y pymes. Estudio independiente en Buenos Aires."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <div class="bg-bg text-text font-body overflow-x-hidden relative">
    <Hero />
    <Offer />
    <Manifesto />
    <BigCTA />
    <SelectedWork />
    <CaseStudy />
    <div class="-mt-px flow-root"><Impact /></div>
    <Process />
    <Contact />
    <Footer />
  </div>
</Layout>
