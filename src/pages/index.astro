---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import Manifiesto from '../components/manifiesto/Manifiesto.astro';
import Desafio from '../components/desafio/Desafio.astro';
import Perspectivas from '../components/perspectivas/Perspectivas.astro';
import Impacto from '../components/impacto/Impacto.astro';
import Trabajo from '../components/trabajo/Trabajo.astro';
import Proceso from '../components/proceso/Proceso.astro';
import Contacto from '../components/contacto/Contacto.astro';
---

<Layout
  title="CounterPoint — Diseño & Desarrollo Web"
  description="Estudio de diseño gráfico y desarrollo web con base en Buenos Aires, Argentina."
>
  <Header />
  <div style="background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); overflow-x: hidden; position: relative;">
    <Hero />
    <Manifiesto />
    <Desafio />
    <Perspectivas />
    <Impacto />
    <Trabajo />
    <Proceso />
    <Contacto />
    <Footer />
  </div>
</Layout>
