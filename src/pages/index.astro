---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import Manifesto from '../components/manifesto/Manifesto.astro';
import Services from '../components/services/Services.astro';
import Perspectives from '../components/perspectives/Perspectives.astro';
import Impact from '../components/impact/Impact.astro';
import Work from '../components/work/Work.astro';
import Process from '../components/process/Process.astro';
import CTA from '../components/cta/CTA.astro';
import Contact from '../components/contact/Contact.astro';
---

<Layout
  title="CounterPoint — Diseño & Desarrollo Web"
  description="Estudio de diseño gráfico y desarrollo web con base en Buenos Aires, Argentina."
>
  <Header />
  <div class="bg-bg text-text font-body overflow-x-hidden relative">
    <Hero />
    <Manifesto />
    <Services />
    <Perspectives />
    <div class="bg-text"><Impact /></div>
    <CTA />
    <div class="bg-accent"><Work /></div>
    <Process />
    <Contact />
    <Footer />
  </div>
</Layout>
