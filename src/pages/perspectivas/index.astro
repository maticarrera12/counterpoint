---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImgSlot from '../../components/ImgSlot.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('perspectivas')).sort((a, b) =>
  a.data.numero.localeCompare(b.data.numero)
);

const tipoLabel: Record<string, string> = {
  ensayo: 'Ensayo',
  'nota-de-campo': 'Nota de campo',
  'lectura-extensa': 'Lectura extensa',
};

function metaLine(data: (typeof papers)[number]['data']) {
  const tipo = tipoLabel[data.tipo];
  if (data.tipo === 'lectura-extensa' && data.palabras) {
    const palabrasFmt = data.palabras.toLocaleString('es-AR');
    return `${tipo} — ${data.fecha} / ${palabrasFmt} palabras`;
  }
  return `${tipo} — ${data.fecha}`;
}
---

<Layout title="Archivo — Perspectivas — CounterPoint" description="El archivo completo de Los Cuadernos de CounterPoint: ideas, decisiones y criterio, por escrito.">
  <Header />
  <div class="bg-bg text-text font-body overflow-x-hidden relative">
    <section class="pt-[clamp(32px,6vw,72px)] px-[clamp(16px,4vw,56px)] pb-[clamp(56px,9vw,130px)]">
      <a href="/#perspectivas" class="text-[11px] tracking-[0.14em] uppercase font-semibold text-muted hover:text-accent transition-colors duration-300">← Volver al inicio</a>

      <div class="mt-[clamp(20px,4vw,40px)] border-b-2 border-divider pb-[clamp(14px,2.4vw,26px)]">
        <div class="text-[11px] tracking-[0.14em] uppercase font-semibold">Archivo</div>
        <h1 class="m-0 mt-2 text-[clamp(34px,6vw,78px)] leading-[0.92] tracking-[-0.04em] uppercase">Los Cuadernos de<br>CounterPoint</h1>
      </div>

      <div class="mt-[clamp(8px,2vw,16px)]">
        {papers.map((paper) => {
          const { data } = paper;
          const esTerminado = data.estado === 'terminado';
          return (
            <article class="grid grid-cols-1 md:grid-cols-12 gap-y-3 md:gap-y-[clamp(14px,2vw,26px)] gap-x-[clamp(8px,1.6vw,22px)] py-[clamp(22px,4vw,48px)] border-b border-divider md:items-center">
              <div class="flex items-baseline gap-4 md:contents">
                <div class="md:col-[1/3] md:row-start-1 text-accent font-heading font-extrabold text-[clamp(26px,3.6vw,52px)] leading-[0.85]">{data.numero}</div>
                <div class="md:col-[9/11] md:row-start-1 text-[11px] tracking-[0.1em] uppercase opacity-65">{metaLine(data)}</div>
              </div>

              <div class="md:col-[3/9] md:row-start-1">
                {!esTerminado && (
                  <div class="mb-1 inline-block text-accent text-[10px] tracking-[0.14em] uppercase font-semibold">Próximamente</div>
                )}
                {esTerminado ? (
                  <h2 class="m-0 text-[clamp(22px,3.2vw,46px)] leading-[0.98] tracking-[-0.03em]">
                    <a href={`/perspectivas/${paper.id}`} class="hover:text-accent transition-colors duration-300">{data.titulo}</a>
                  </h2>
                ) : (
                  <h2 class="m-0 text-[clamp(22px,3.2vw,46px)] leading-[0.98] tracking-[-0.03em] line-through text-muted">{data.titulo}</h2>
                )}
              </div>

              <div class="md:col-[11/13] md:row-start-1 relative h-28 md:h-[clamp(70px,9vw,110px)]">
                <ImgSlot src={data.imagen} alt={data.titulo} />
              </div>
            </article>
          );
        })}
      </div>
    </section>
    <Footer />
  </div>
</Layout>
